/* Windows resources for atlas-commander.exe.
 *
 * Two things live here. The icon, which is what Explorer, the taskbar and Alt-Tab
 * show — without it the exe gets the generic one, which makes a finished
 * application look like a loose build artefact. And the version block, which is
 * what the Properties dialog reads, so "which version is this?" has an answer
 * without running it.
 *
 * @VERSION@ and @V_COMMA@ are substituted by packaging/stage-windows.sh from the
 * VERSION file, so this cannot drift from what the app reports about itself.
 *
 * Every string here is ASCII on purpose. windres assumes CP1252 unless told
 * otherwise, and the build passes --codepage=65001 so UTF-8 would work — but a
 * resource string that renders as three stray characters in Explorer's Properties
 * dialog is not worth an em-dash on a platform this cannot be checked on.
 */
1 ICON "assets/atlas.ico"

1 VERSIONINFO
FILEVERSION    @V_COMMA@
PRODUCTVERSION @V_COMMA@
FILEOS         0x4L  /* VOS__WINDOWS32 */
FILETYPE       0x1L  /* VFT_APP */
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        /* 0409 is US English, 04b0 is UTF-16. */
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "EternalCoder454"
            VALUE "FileDescription",  "Atlas Commander - run a fleet of Claude agents"
            VALUE "FileVersion",      "@VERSION@"
            VALUE "InternalName",     "atlas-commander"
            VALUE "LegalCopyright",   "MIT licensed. See LICENSE."
            VALUE "OriginalFilename", "atlas-commander.exe"
            VALUE "ProductName",      "Atlas Commander"
            VALUE "ProductVersion",   "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x4b0
    END
END
