# Maintainer: EternalCoder454 <77252745+EternalCoder454@users.noreply.github.com>
#
# Arch package for Atlas Commander.
#
#   makepkg -si               build and install with pacman
#   pacman -R atlas-commander remove it again
#
# Builds the tagged release. sha256sums is 'SKIP' until a release exists to
# checksum; fill it in with `updpkgsums` when one is published.
pkgname=atlas-commander
pkgver=0.1.0
pkgrel=1
pkgdesc="Run, watch and govern a fleet of Claude agents"
arch=('x86_64')
url="https://github.com/EternalCoder454/atlas-commander"
license=('MIT')
depends=('qt6-base' 'qt6-svg')
makedepends=('go>=1.24' 'gcc' 'pkgconf')
checkdepends=('desktop-file-utils')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    # cgo is not optional here: the Qt bindings are cgo.
    export CGO_ENABLED=1
    export CGO_CPPFLAGS="${CPPFLAGS}"
    export CGO_CFLAGS="${CFLAGS}"
    export CGO_CXXFLAGS="${CXXFLAGS}"
    export CGO_LDFLAGS="${LDFLAGS}"
    export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw -ldflags=-linkmode=external"
    go build -o bin/ ./cmd/...
}

check() {
    cd "$pkgname-$pkgver"
    # The Go tests are run in CI; here only the desktop entry is checked,
    # because it is generated during package().
    desktop-file-validate assets/com.atlas.Commander.desktop
}

package() {
    cd "$pkgname-$pkgver"
    # atlas-hook goes beside atlas-commander, which looks for it there.
    install -Dm755 bin/atlas-commander "$pkgdir/usr/bin/atlas-commander"
    install -Dm755 bin/atlas-hook "$pkgdir/usr/bin/atlas-hook"
    install -Dm644 assets/icon.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/com.atlas.Commander.svg"
    install -Dm644 assets/icon-16.svg \
        "$pkgdir/usr/share/icons/hicolor/16x16/apps/com.atlas.Commander.svg"
    install -Dm644 assets/icon-symbolic.svg \
        "$pkgdir/usr/share/icons/hicolor/symbolic/apps/com.atlas.Commander-symbolic.svg"

    # The desktop file carries a placeholder for wherever the binary landed.
    install -d "$pkgdir/usr/share/applications"
    sed 's|@BIN@|/usr/bin/atlas-commander|g' assets/com.atlas.Commander.desktop \
        > "$pkgdir/usr/share/applications/com.atlas.Commander.desktop"
    chmod 644 "$pkgdir/usr/share/applications/com.atlas.Commander.desktop"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
