<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Matches the light scheme's page colour so launch does not flash a
         different colour before the first frame; values-night has the dark one. -->
    <style name="Theme.AtlasCommander" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#fafafb</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
